#!/bin/sh
echo "Running pre-push checks..."

echo "1/3 TypeScript..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors. Push blocked."
  exit 1
fi

echo "2/3 Build check..."
npm run build 2>&1 | tail -3
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Push blocked."
  exit 1
fi

echo "3/3 Playwright smoke tests..."
npx playwright test tests/e2e/agency-pages.spec.ts tests/e2e/api-smoke.spec.ts --reporter=list
if [ $? -ne 0 ]; then
  echo "❌ Playwright tests failed. Push blocked."
  echo "Run: npx playwright test --reporter=html to see full report"
  exit 1
fi

echo "✅ All checks passed. Pushing."
